yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# INTRIGUE V12 deployment safety
.env*
!.env.example
.vercel/
.next/
node_modules/
*.backup*
*.bak
*.v*-backup*
*.before-model-fix
